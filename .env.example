# =================================================================
# EDUGESTÃO CORE PRO - CONFIGURAÇÃO DE CHAVES E APIS (VITE)
# =================================================================
# ATENÇÃO: Nunca envie o arquivo .env com chaves reais para o Git!
# O arquivo .env.example serve como modelo.

# -----------------------------------------------------------------
# 1. Cloudflare R2 / Storage (Upload de Fotos e Documentos)
# -----------------------------------------------------------------
VITE_CLOUDFLARE_ACCOUNT_ID=seu_account_id_aqui
VITE_CLOUDFLARE_R2_BUCKET_NAME=edugestao-media
VITE_CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# -----------------------------------------------------------------
# 2. ViaCEP (Consulta pública gratuita de endereços)
# Nota: ViaCEP não exige chave de API, mas deixamos a URL configurável
# -----------------------------------------------------------------
VITE_VIACEP_API_URL=https://viacep.com.br/ws

# -----------------------------------------------------------------
# 3. Notificações e Comunicação (WhatsApp & E-mail)
# -----------------------------------------------------------------
VITE_WHATSAPP_API_URL=https://api.z-api.io/instances/sua_instancia/token/seu_token
VITE_RESEND_API_KEY=re_123456789_sua_chave_resend

# -----------------------------------------------------------------
# 4. Asaas (Cobrança & Boletos/PIX)
# -----------------------------------------------------------------
VITE_ASAAS_API_KEY=$aact_Y3VzdG9tZXJf...
VITE_ASAAS_ENVIRONMENT=sandbox # ou production

# -----------------------------------------------------------------
# 5. Inteligência Artificial (OpenAI / Gemini)
# -----------------------------------------------------------------
VITE_OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
VITE_GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXX
